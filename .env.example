# ---------------------------------------------------------------------------
# KanoEats environment
# Copy to .env.local and fill in. .env.local is git-ignored.
#
# Everything here is OPTIONAL. With no values the app still runs against local
# menu data — you just cannot sign in, place orders, or take payments.
#
# WARNING: anything prefixed VITE_ is compiled into the browser bundle and is
# publicly visible. Never put a secret key here. The Paystack SECRET key lives
# in Supabase Edge Function secrets, not in this file.
# ---------------------------------------------------------------------------

# Supabase — Project Settings → API
# Enables accounts, orders, addresses and the kitchen dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paystack — Dashboard → Settings → API Keys (use the TEST key while developing)
# Enables card, transfer and USSD payment at checkout.
# Without it, checkout offers cash on delivery only.
VITE_PAYSTACK_PUBLIC_KEY=
